{
  "name": "lubian-gestao",
  "version": "1.0.0",
  "description": "Sistema de gestão da Lubian Limpezas",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "orcamento": "tsx scripts/gerar-orcamento.ts",
    "fatura": "tsx scripts/gerar-fatura.ts",
    "recibo": "tsx scripts/gerar-recibo.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "tsx scripts/db-migrar.ts",
    "db:semear": "tsx scripts/db-semear.ts",
    "teste:e2e": "tsx --env-file-if-exists=.env.local scripts/teste-e2e.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flavialubian-tech/lubian.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/flavialubian-tech/lubian/issues"
  },
  "homepage": "https://github.com/flavialubian-tech/lubian#readme",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.3",
    "handlebars": "^4.7.9",
    "next": "^16.3.8",
    "playwright-core": "^1.63.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
